# Groq API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration (Supports PostgreSQL, MySQL, SQLite)
# Defaults to local SQLite file 'investigations.db' if omitted
# PostgreSQL example: postgresql://username:password@localhost:5432/rca_pharma_db
# MySQL example: mysql+pymysql://username:password@localhost:3306/rca_pharma_db
DATABASE_URL=sqlite:///./investigations.db
